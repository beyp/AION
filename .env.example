# AION Environment Variables
# Copier ce fichier en .env et remplir les valeurs

# ── Azure DevOps ─────────────────────────────────────────────────────────────
ADO_PAT=your_personal_access_token_here
ADO_ORG=Premiertech

# ── Groq API (IA cloud gratuit) ───────────────────────────────────────────────
# Cree une cle gratuite sur : https://console.groq.com
# Quota gratuit : 14400 requetes/jour
GROQ_API_KEY=gsk_your_groq_api_key_here
